APP_NAME="Vamoseone"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
TRUSTED_PROXIES=REMOTE_ADDR
APP_TIMEZONE=Africa/Addis_Ababa
SESSION_DRIVER=database
# file is correct for a single server. Set database ONLY with a cache table
# migrated; redis only if the extension and server actually exist.
CACHE_STORE=file
# Required before /clear-deploy-cache will answer; leave empty to disable it.
DEPLOY_CACHE_TOKEN=
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=game
DB_USERNAME=root
DB_PASSWORD=

